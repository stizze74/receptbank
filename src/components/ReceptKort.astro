---
import type { CollectionEntry } from 'astro:content';
import { summeraTid } from '../utils/format';
import { bildUrl, bildAlt } from '../utils/bild';

type AnyRecept =
  | CollectionEntry<'baser'>
  | CollectionEntry<'proteiner'>
  | CollectionEntry<'saser'>
  | CollectionEntry<'tillbehor'>
  | CollectionEntry<'soppor'>
  | CollectionEntry<'middagar'>

  | CollectionEntry<'snacks'>

  | CollectionEntry<'drycker'>

  | CollectionEntry<'efterratter'>

  | CollectionEntry<'forratter'>

  | CollectionEntry<'brod'>
  | CollectionEntry<'frukost'>
  | CollectionEntry<'sallader'>
  | CollectionEntry<'forrad'>
  | CollectionEntry<'grill'>
  | CollectionEntry<'glass'>
  | CollectionEntry<'festmat'>;

interface Props {
  recept: AnyRecept;
}

const { recept } = Astro.props;
const d = recept.data;
const tid = summeraTid(d.tid);
const planerad = d.status === 'planerad';
const noterad = d.status === 'noterad';
const bild = bildUrl(recept);
const initial = d.namn.charAt(0).toUpperCase();
---

<a
  href={`/recept/${recept.id}`}
  class:list={[
    'kort group flex flex-col overflow-hidden p-0 no-underline',
    planerad && 'border-dashed opacity-70',
    noterad && 'bg-amber-50/40',
  ]}
>
  {bild ? (
    <img
      src={bild}
      alt={bildAlt(recept)}
      loading="lazy"
      class="aspect-[3/4] w-full object-cover transition duration-200 group-hover:scale-[1.03]"
    />
  ) : (
    <div class="aspect-[3/4] flex flex-col items-center justify-center gap-1 bg-gradient-to-br from-bas-100 via-bas-50 to-bas-200 text-bas-600">
      <span class="text-7xl font-light leading-none opacity-30">{initial}</span>
      <span class="text-[10px] uppercase tracking-[0.25em]">{d.modul}</span>
    </div>
  )}
  <div class="flex flex-col gap-1 p-3">
    <div class="flex flex-wrap items-center gap-1">
      <span class="modul-tagg bg-bas-200 text-bas-800">{d.modul}</span>
      {planerad && <span class="modul-tagg bg-amber-200 text-amber-900">planerad</span>}
      {noterad && <span class="modul-tagg bg-amber-300 text-amber-900">köpt</span>}
      {d.jessica_tagg && (
        <span class="modul-tagg bg-purple-200 text-purple-900">{d.jessica_tagg}</span>
      )}
    </div>
    <span class="text-base font-semibold leading-tight">{d.namn}</span>
    <div class="flex flex-wrap items-center gap-2 text-xs text-bas-700">
      {tid !== undefined && <span>{tid} min</span>}
      {d.narings_per_portion && (
        <span>{d.narings_per_portion.netto_kh} g kh</span>
      )}
      {d.taggar?.length > 0 && <span class="truncate">· {d.taggar.slice(0, 3).join(' · ')}</span>}
    </div>
  </div>
</a>
