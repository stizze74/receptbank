---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Ingredienslista from '../components/Ingredienslista.astro';
import Tillagningslista from '../components/Tillagningslista.astro';
import CookingMode from '../components/CookingMode.astro';
import Testlogg from '../components/Testlogg.astro';
import { recipeJsonLd } from '../utils/jsonld';
import { summeraTid } from '../utils/format';
import { bildUrl, bildAlt } from '../utils/bild';

type AnyRecept =
  | CollectionEntry<'baser'>
  | CollectionEntry<'proteiner'>
  | CollectionEntry<'saser'>
  | CollectionEntry<'tillbehor'>
  | CollectionEntry<'soppor'>
  | CollectionEntry<'middagar'>;

interface Props {
  recept: AnyRecept;
}

const { recept } = Astro.props;
const d = recept.data;

const sitan = Astro.site?.toString() ?? 'https://recept.hjerne.net';
const ld = recipeJsonLd(recept, sitan);

const tid = summeraTid(d.tid);
const planerad = d.status === 'planerad';
const noterad = d.status === 'noterad';

const matlistaUrl = new URL(`/recept/${recept.id}`, sitan).toString();
const bild = bildUrl(recept);
---

<BaseLayout titel={d.namn} jsonLd={ld}>
  {bild && (
    <figure class="mb-4 -mx-3 sm:mx-0 sm:rounded-xl overflow-hidden">
      <img
        src={bild}
        alt={bildAlt(recept)}
        class="w-full aspect-[4/3] object-cover sm:aspect-[16/9]"
      />
    </figure>
  )}
  <header class="mb-4">
    <div class="mb-1 flex flex-wrap items-center gap-1">
      <span class="modul-tagg bg-bas-200 text-bas-800">{d.modul}</span>
      {d.taggar?.map((t) => (
        <span class="modul-tagg bg-bas-100 text-bas-800">{t}</span>
      ))}
      {planerad && <span class="modul-tagg bg-amber-200 text-amber-900">planerad</span>}
      {noterad && <span class="modul-tagg bg-amber-300 text-amber-900">köpt genväg</span>}
    </div>
    <h1 class="text-2xl">{d.namn}</h1>

    <div class="mt-2 flex flex-wrap gap-3 text-sm text-bas-700">
      {tid !== undefined && <span>⏱ {tid} min</span>}
      <span>👥 {d.portioner} portioner</span>
      {d.narings_per_portion && (
        <span>
          {d.narings_per_portion.netto_kh} g kh · {d.narings_per_portion.fett} g fett · {d.narings_per_portion.protein} g protein · {d.narings_per_portion.kcal} kcal/portion
        </span>
      )}
      {d.forvantad_glukospaverkan && d.forvantad_glukospaverkan !== '-' && (
        <span class="rounded-full bg-bas-100 px-2 py-0.5">
          glukos: {d.forvantad_glukospaverkan}
        </span>
      )}
    </div>
  </header>

  {noterad && d.inkop && (
    <section class="kort mb-4 border-amber-300 bg-amber-50/40 text-sm">
      <strong class="block font-semibold">Köpinfo: </strong>
      {d.inkop}
    </section>
  )}

  {planerad && (
    <section class="kort mb-4 border-dashed text-sm text-bas-700">
      <strong class="block">Skelett-recept</strong>
      Detta är ett planerat recept utan färdiga steg. Editera <code>.md</code>-filen
      när du provkokat det.
    </section>
  )}

  {!planerad && d.ingredienser.length > 0 && (
    <Ingredienslista ingredienser={d.ingredienser} portioner={d.portioner} />
  )}

  {!planerad && d.tillagning.length > 0 && (
    <Tillagningslista tillagning={d.tillagning} />
  )}

  {d.tips?.length > 0 && (
    <section class="mb-6">
      <h2 class="mb-2 text-lg">Tips</h2>
      <ul class="space-y-1 text-sm">
        {d.tips.map((t) => <li>· {t}</li>)}
      </ul>
    </section>
  )}

  {!planerad && d.ingredienser.length > 0 && (
    <section class="mb-6">
      <h2 class="mb-2 text-lg">Inköpslista</h2>
      <a
        href={`/recept/${recept.id}/inkop/`}
        class="kort mb-3 flex items-center justify-between gap-2 no-underline transition hover:bg-bas-50"
      >
        <div>
          <span class="block text-base font-semibold text-bas-800">→ Öppna inköpsläge</span>
          <span class="block text-xs text-bas-700">
            Tryck på en vara, kopiera, klistra in i inköpsappen, tillbaka, nästa.
            Bockar av automatiskt.
          </span>
        </div>
        <span class="text-xl">🛒</span>
      </a>
      <details class="kort text-sm">
        <summary class="cursor-pointer text-bas-700">
          Eller dela hela receptet till Matlistan / annan app (för familjedelning)
        </summary>
        <p class="mt-2 text-xs text-bas-700">
          Skickar URL till en ren version av receptet. Matlistan importerar det som
          recept i din recept-samling — sen kan du där trycka "Lägg till i
          inköpslista".
        </p>
        <button
          type="button"
          id="ml-dela-recept"
          class="knapp-sekundar mt-2 hidden"
        >
          Dela receptet…
        </button>
      </details>
    </section>
  )}

  <slot />

  {!planerad && (
    <section class="mb-6">
      <details class="kort">
        <summary class="cursor-pointer text-sm font-semibold">📷 Ladda upp foto</summary>
        <div class="mt-3 space-y-2 text-sm">
          <p class="text-bas-700">
            Foto sparas till receptet och blir live efter ~30 sek.
            Tokenet sparas i webbläsaren (localStorage) — du anger det en gång.
          </p>
          <input
            type="file"
            id="bild-fil"
            accept="image/jpeg,image/png,image/webp,image/avif"
            class="block w-full text-sm"
          />
          <input
            type="text"
            id="bild-alt"
            placeholder="Beskrivning av bilden (valfritt)"
            class="block w-full rounded-md border border-bas-300 px-2 py-1"
          />
          <div class="flex gap-2">
            <button type="button" id="bild-upload" data-slug={recept.id} class="knapp-primar">
              Ladda upp
            </button>
            <button type="button" id="bild-token" class="knapp-sekundar text-xs">
              Sätt om token
            </button>
          </div>
          <p id="bild-status" class="text-xs text-bas-700"></p>
        </div>
      </details>
    </section>
  )}

  <Testlogg recept={recept} />

  <CookingMode />
</BaseLayout>

<script>
  // Dela receptet via Web Share — pekar mot ren recept-sub-sida (ingredienser + steg, inga formulär)
  const delaRecept = document.getElementById('ml-dela-recept') as HTMLButtonElement | null;
  if (delaRecept && typeof navigator.share === 'function') {
    delaRecept.classList.remove('hidden');
    delaRecept.addEventListener('click', async () => {
      const slug = location.pathname.replace(/^\/recept\//, '').replace(/\/$/, '');
      const delaUrl = `${location.origin}/recept/${slug}/dela/`;
      try {
        await navigator.share({ url: delaUrl });
      } catch {
        // användaren avbröt
      }
    });
  }

  // ---- Bild-upload via MCP ----
  const TOKEN_KEY = 'mcp-token';
  const MCP_URL = 'https://mcp-recept.hjerne.net/mcp';

  const getToken = (): string | null => {
    let t = localStorage.getItem(TOKEN_KEY);
    if (!t) {
      t = window.prompt('Klistra in MCP_TOKEN (sparas i denna browser för framtida uploads):');
      if (t) localStorage.setItem(TOKEN_KEY, t.trim());
    }
    return t?.trim() || null;
  };

  const uploadBtn = document.getElementById('bild-upload') as HTMLButtonElement | null;
  const tokenBtn = document.getElementById('bild-token') as HTMLButtonElement | null;
  const fileInp = document.getElementById('bild-fil') as HTMLInputElement | null;
  const altInp = document.getElementById('bild-alt') as HTMLInputElement | null;
  const status = document.getElementById('bild-status') as HTMLElement | null;

  tokenBtn?.addEventListener('click', () => {
    localStorage.removeItem(TOKEN_KEY);
    if (status) status.textContent = 'Token borttaget. Du blir tillfrågad nästa gång.';
  });

  const fileToBase64 = (file: File): Promise<string> =>
    new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const result = reader.result as string;
        resolve(result.split(',')[1] ?? '');
      };
      reader.onerror = () => reject(reader.error);
      reader.readAsDataURL(file);
    });

  uploadBtn?.addEventListener('click', async () => {
    if (!fileInp?.files?.[0]) {
      if (status) status.textContent = 'Välj en bildfil först.';
      return;
    }
    const file = fileInp.files[0];
    const slug = uploadBtn.dataset.slug;
    if (!slug) return;

    const token = getToken();
    if (!token) {
      if (status) status.textContent = 'Token krävs.';
      return;
    }

    const ext = (file.name.split('.').pop() || 'jpg').toLowerCase();
    const filnamn = `${slug}.${ext}`;
    const altText = altInp?.value.trim() || undefined;

    if (status) status.textContent = `Läser ${(file.size / 1024).toFixed(0)} KB…`;
    uploadBtn.disabled = true;

    try {
      const base64 = await fileToBase64(file);
      if (status) status.textContent = 'Skickar till servern…';

      const args: Record<string, unknown> = { slug, filnamn, base64_data: base64 };
      if (altText) args.alt_text = altText;

      const resp = await fetch(MCP_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json, text/event-stream',
          'Authorization': `Bearer ${token}`,
        },
        body: JSON.stringify({
          jsonrpc: '2.0',
          id: Date.now(),
          method: 'tools/call',
          params: { name: 'lagg_till_bild', arguments: args },
        }),
      });

      if (resp.status === 401) {
        localStorage.removeItem(TOKEN_KEY);
        if (status) status.textContent = 'Token avvisades. Tryck "Ladda upp" igen och ange korrekt token.';
        return;
      }

      const text = await resp.text();
      // Streamable HTTP returnerar event-stream — extrahera JSON ur "data: ..."
      const match = text.match(/data:\s*(\{.*\})/);
      const data = match ? JSON.parse(match[1]) : JSON.parse(text);

      if (data.error) {
        if (status) status.textContent = `Fel: ${data.error.message ?? 'okänt'}`;
        return;
      }

      if (status) {
        status.textContent = 'Sparat ✓ Sajten byggs om (~30 sek). Reloadar…';
      }
      setTimeout(() => location.reload(), 35_000);
    } catch (e) {
      if (status) status.textContent = `Fel: ${(e as Error).message}`;
    } finally {
      uploadBtn.disabled = false;
    }
  });
</script>
