---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allaCollections = await Promise.all([
  getCollection('baser'),
  getCollection('proteiner'),
  getCollection('saser'),
  getCollection('tillbehor'),
  getCollection('soppor'),
  getCollection('middagar'),
  getCollection('snacks'),
  getCollection('drycker'),
  getCollection('efterratter'),
  getCollection('forratter'),
  getCollection('brod'),
    getCollection('frukost'),
    getCollection('sallader'),
    getCollection('forrad'),
    getCollection('grill'),
    getCollection('glass'),
    getCollection('festmat'),
]);
const alla = allaCollections.flat();

const skrivna = alla.filter((r) => r.data.status === 'skriven' || r.data.status === 'testad');
const planerade = alla.filter((r) => r.data.status === 'planerad');

const senaste = skrivna.slice(0, 6);

const slumpbaraFlera = (...moduler: string[]) =>
  skrivna.filter((r) => moduler.includes(r.data.modul)).map((r) => r.id);

const matModuler = ['middag', 'soppa', 'sallad', 'festmat'];
const jessicaIds = skrivna
  .filter((r) => matModuler.includes(r.data.modul) && r.data.jessica_tagg)
  .map((r) => r.id);

const slumpaListor = {
  frukost: slumpbaraFlera('frukost'),
  lunch: slumpbaraFlera('sallad', 'soppa'),
  middag: slumpbaraFlera('middag', 'soppa'),
  jessica: jessicaIds,
};

const moduler = [
  { titel: 'Baser', slug: 'baser', mojligt: 'bas' },
  { titel: 'Proteiner', slug: 'proteiner', mojligt: 'protein' },
  { titel: 'Såser', slug: 'saser', mojligt: 'sas' },
  { titel: 'Tillbehör', slug: 'tillbehor', mojligt: 'tillbehor' },
  { titel: 'Soppor', slug: 'soppor', mojligt: 'soppa' },
  { titel: 'Middagar', slug: 'middagar', mojligt: 'middag' },
  { titel: 'Snacks', slug: 'snacks', mojligt: 'snack' },
  { titel: 'Drycker', slug: 'drycker', mojligt: 'dryck' },
  { titel: 'Efterrätter', slug: 'efterratter', mojligt: 'efterratt' },
  { titel: 'Förrätter', slug: 'forratter', mojligt: 'forratt' },
  { titel: 'Bröd & bullar', slug: 'brod', mojligt: 'brod' },
  { titel: 'Frukost', slug: 'frukost', mojligt: 'frukost' },
  { titel: 'Sallader & lunch', slug: 'sallader', mojligt: 'sallad' },
  { titel: 'Förråd', slug: 'forrad', mojligt: 'forrad' },
  { titel: 'Grill', slug: 'grill', mojligt: 'grill' },
  { titel: 'Glass & frusen', slug: 'glass', mojligt: 'glass' },
  { titel: 'Fest- & helgmat', slug: 'festmat', mojligt: 'festmat' },
];
---

<BaseLayout titel="Start">
  <h1 class="mb-1 text-2xl">Receptbank</h1>
  <p class="mb-4 text-sm text-bas-700">
    LCHF · ~5–10 g netto kh per måltid · {skrivna.length} skrivna recept · {planerade.length} planerade
  </p>

  <section class="mb-6">
    <h2 class="mb-2 text-lg">Vad ska jag äta?</h2>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      <button type="button" data-slumpa="frukost" class="kort flex flex-col gap-1 text-left hover:bg-bas-50">
        <span class="text-xs uppercase tracking-wide text-bas-600">Slumpa</span>
        <span class="text-base font-semibold">Frukost →</span>
        <span class="text-xs text-bas-600">{slumpaListor.frukost.length} st</span>
      </button>
      <button type="button" data-slumpa="lunch" class="kort flex flex-col gap-1 text-left hover:bg-bas-50">
        <span class="text-xs uppercase tracking-wide text-bas-600">Slumpa</span>
        <span class="text-base font-semibold">Lunch →</span>
        <span class="text-xs text-bas-600">{slumpaListor.lunch.length} st</span>
      </button>
      <button type="button" data-slumpa="middag" class="kort flex flex-col gap-1 text-left hover:bg-bas-50">
        <span class="text-xs uppercase tracking-wide text-bas-600">Slumpa</span>
        <span class="text-base font-semibold">Middag →</span>
        <span class="text-xs text-bas-600">{slumpaListor.middag.length} st</span>
      </button>
      <button type="button" data-slumpa="jessica" class="kort flex flex-col gap-1 text-left hover:bg-bas-50">
        <span class="text-xs uppercase tracking-wide text-bas-600">Slumpa</span>
        <span class="text-base font-semibold">Jessica →</span>
        <span class="text-xs text-bas-600">{slumpaListor.jessica.length} st</span>
      </button>
    </div>
    <div class="mt-2 grid grid-cols-2 gap-2">
      <a href="/veckoplan" class="kort flex flex-col gap-1 no-underline hover:bg-bas-50">
        <span class="text-xs uppercase tracking-wide text-bas-600">Hela veckan</span>
        <span class="text-base font-semibold">Veckoplan →</span>
      </a>
      <a href="/kombinera" class="kort flex flex-col gap-1 no-underline hover:bg-bas-50">
        <span class="text-xs uppercase tracking-wide text-bas-600">Bygg från moduler</span>
        <span class="text-base font-semibold">Kombinera →</span>
      </a>
    </div>
  </section>

  <script define:vars={{ SLUMPA: slumpaListor }}>
    document.querySelectorAll('[data-slumpa]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const typ = btn.getAttribute('data-slumpa');
        const lista = SLUMPA[typ] ?? [];
        if (lista.length === 0) {
          alert(`Inga recept i ${typ}-samlingen än.`);
          return;
        }
        const id = lista[Math.floor(Math.random() * lista.length)];
        location.href = `/recept/${id}`;
      });
    });
  </script>

  <section class="mb-6">
    <h2 class="mb-2 text-lg">Senaste recept</h2>
    {senaste.length === 0 && (
      <p class="text-sm text-bas-700">Inga recept skrivna än. Kolla planerade nedan.</p>
    )}
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      {senaste.map((r) => (
        <a href={`/recept/${r.id}`} class="kort flex flex-col gap-0.5 no-underline hover:bg-bas-50">
          <span class="text-xs uppercase tracking-wide text-bas-600">{r.data.modul}</span>
          <span class="font-semibold">{r.data.namn}</span>
          {r.data.tid?.total_min && (
            <span class="text-xs text-bas-700">{r.data.tid.total_min} min</span>
          )}
        </a>
      ))}
    </div>
  </section>

  <section class="mb-6">
    <h2 class="mb-2 text-lg">Bläddra</h2>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
      {moduler.map((m) => (
        <a href={`/alla?modul=${m.mojligt}`} class="kort no-underline hover:bg-bas-50">
          <span class="block text-sm font-semibold">{m.titel}</span>
          <span class="block text-xs text-bas-600">
            {alla.filter((r) => r.data.modul === m.mojligt).length} st
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
