---
import { getCollection, render } from 'astro:content';
import ReceptLayout from '../../layouts/ReceptLayout.astro';

export async function getStaticPaths() {
  const collections = ['baser', 'proteiner', 'saser', 'tillbehor', 'soppor', 'middagar', 'snacks', 'drycker', 'efterratter', 'forratter', 'brod'] as const;
  const allEntries = await Promise.all(collections.map((c) => getCollection(c)));
  return allEntries.flat().map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ReceptLayout recept={entry}>
  <article class="prose prose-sm max-w-none text-bas-800">
    <Content />
  </article>
</ReceptLayout>
